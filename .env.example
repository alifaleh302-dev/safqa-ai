# ===== Telegram (from https://my.telegram.org -> API development tools) =====
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ===== Gemini (from https://aistudio.google.com/apikey) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ===== Security =====
# Used to encrypt Telethon sessions at rest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ===== Database =====
DATABASE_URL=sqlite:///./data/app.db
# For production use Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@db:5432/negotiator

# ===== Human-like behaviour & anti-spam limits =====
REPLY_MIN_DELAY=2
REPLY_MAX_DELAY=9
MAX_CONTEXT_MESSAGES=15
MAX_REPLIES_PER_HOUR=20
MAX_REPLIES_PER_DAY=200
