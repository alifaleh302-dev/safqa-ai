# ===== Telegram (from https://my.telegram.org -> API development tools) =====
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ===== Gemini (from https://aistudio.google.com/apikey) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.5-flash

# ===== Security =====
# Used to encrypt Telethon sessions at rest. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ===== Admin login (web UI) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# JWT signing secret; falls back to SECRET_KEY if empty. Generate like SECRET_KEY.
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# ===== Database =====
DATABASE_URL=sqlite:///./data/app.db
# For production use Postgres, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@db:5432/negotiator

# ===== Postgres (used by docker compose) =====
POSTGRES_USER=negotiator
POSTGRES_PASSWORD=negotiator
POSTGRES_DB=negotiator

# ===== Human-like behaviour & anti-spam limits =====
REPLY_MIN_DELAY=2
REPLY_MAX_DELAY=9
MAX_CONTEXT_MESSAGES=15
MAX_REPLIES_PER_HOUR=20
MAX_REPLIES_PER_DAY=200
