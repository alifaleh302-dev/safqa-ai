# Single-service image: builds the React app, then serves it from FastAPI.
# Used by Railway via the repository-root railway.json (root dir = repo root).
# The compose flow keeps using backend/Dockerfile + frontend/Dockerfile.

# ---------- build the frontend ----------
FROM node:20-alpine AS frontend
WORKDIR /fe
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci || npm install
COPY frontend/ ./
RUN npm run build

# ---------- backend that also serves the SPA ----------
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app ./app
COPY backend/seed ./seed
RUN mkdir -p /app/data
COPY --from=frontend /fe/dist ./static
ENV SPA_DIR=/app/static

EXPOSE 8000
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
